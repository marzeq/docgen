{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Generated Documentation File",
  "type": "array",
  "items": {
    "$ref": "#/$defs/doc_comment"
  },
  "$defs": {
    "doc_location": {
      "type": "object",
      "properties": {
        "file": {
          "type": "string"
        },
        "line": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": ["file", "line"],
      "additionalProperties": false
    },
    "doc_param_field": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "doc_comment": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "module": {
          "type": "string"
        },
        "namespace": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "header": {
          "type": "string"
        },
        "return": {
          "type": "string"
        },
        "deprecated": {
          "type": "string"
        },
        "examples": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "see_also": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "params": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/doc_param_field"
          }
        },
        "fields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/doc_param_field"
          }
        },
        "location": {
          "$ref": "#/$defs/doc_location"
        }
      },
      "required": ["location", "name"],
      "additionalProperties": false
    }
  }
}
